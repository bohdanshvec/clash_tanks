<h1>Играть</h1>

<p>
  <strong>Бой с ИИ:</strong>
  сразиться с искусственным интеллектом можно готовой колодой
  с весом <strong>12–14</strong>, <strong>20–24</strong> или
  <strong>26–30</strong>.
  Диапазон зависит от веса одной из доступных колод ИИ.
  Если кнопки «В бой — ИИ» нет у какой-либо колоды, значит,
  её вес не подходит ни под один из этих диапазонов.
</p>

<h2>Мои колоды</h2>

<% if @decks.any? %>
  <div class="play-decks">
    <% @decks.each do |deck| %>
      <div class="deck-card">
        <h3><%= deck.name %></h3>

        <p>
          <strong>Нация:</strong>
          <%= deck.nation.name %>
        </p>

        <p>
          <strong>Штаб:</strong>
          <%= deck.headquarters_card.name %>
        </p>

        <p>
          <strong>Вес:</strong>
          <%= deck.weight %>
        </p>

        <div class="deck-card__actions">
          <%= button_to "В бой — PvP",
                        games_path,
                        method: :post,
                        params: {
                          deck_id: deck.id,
                          mode: "pvp"
                        } %>

          <% if @ai_decks_by_deck_id[deck.id].present? %>
            <%= button_to "В бой — ИИ",
                          games_path,
                          method: :post,
                          params: {
                            deck_id: deck.id,
                            mode: "ai"
                          } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>У вас пока нет готовых колод.</p>

  <% if registered_player? %>
    <p>
      <%= link_to "Создать колоду", new_deck_path %>
    </p>
  <% end %>
<% end %>
