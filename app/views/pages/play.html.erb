<h1>Играть</h1>

<h2>Мои колоды</h2>

<% if @decks.any? %>
  <div class="play-decks">
    <% @decks.each do |deck| %>
      <div class="deck-card">
        <h3><%= deck.name %></h3>

        <p>
          <strong>Нация:</strong>
          <%= deck.nation.name %>
        </p>

        <p>
          <strong>Штаб:</strong>
          <%= deck.headquarters_card.name %>
        </p>

        <p>
          <strong>Вес:</strong>
          <%= deck.weight %>
        </p>

        <div class="deck-card__actions">
          <%= button_to "В бой — PvP",
                        games_path,
                        method: :post,
                        params: {
                          deck_id: deck.id,
                          mode: "pvp"
                        } %>

          <% if @ai_decks_by_deck_id[deck.id].present? %>
            <%= button_to "В бой — ИИ",
                          games_path,
                          method: :post,
                          params: {
                            deck_id: deck.id,
                            mode: "ai"
                          } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>У вас пока нет готовых колод.</p>

  <% if registered_player? %>
    <p>
      <%= link_to "Создать колоду", new_deck_path %>
    </p>
  <% end %>
<% end %>
