<div class="play-decks-page">
  <header class="cards-page__header page-title-panel">
    <h1>Грати</h1>

    <p>
      <strong>Бій з АІ:</strong>
      грати зі штучним інтелектом можна готовою колодою з вагою
      <strong>36–44</strong>, <strong>45–55</strong> або <strong>52–63</strong>.
      Діапазон залежить від ваги однієї з доступних колод АІ.
      Якщо кнопки «В бій — АІ» немає у будь-якої колоди, її
      вага не підходить ні під один з цих діапазонів.
    </p>
  </header>

  <h2 class="play-decks-page__section-title">Мої колоди</h2>

  <% if @decks.any? %>

    <div class="play-decks">

      <% @decks.each do |deck| %>

        <article class="deck-card">

          <div class="deck-card__headquarters">

            <%= render "cards/card",
                       card: deck.headquarters_card %>

          </div>

          <section class="deck-card__info">

            <h2>
              <%= deck.name %>
            </h2>

            <div class="deck-card__metrics">

              <p class="deck-card__metric">
                <span>Вага</span>

                <strong>
                  <%= deck.weight %>
                </strong>
              </p>

            </div>

          </section>

          <div class="deck-card__actions">

            <%= button_to "В бій — PvP",
                          games_path,
                          method: :post,
                          params: {
                            deck_id: deck.id,
                            mode: "pvp"
                          } %>

            <% if @ai_decks_by_deck_id[deck.id].present? %>
              <%= button_to "В бій — АІ",
                            games_path,
                            method: :post,
                            params: {
                              deck_id: deck.id,
                              mode: "ai"
                            } %>
            <% end %>

          </div>

        </article>

      <% end %>

    </div>

  <% else %>

    <p>У вас поки немає готових колод.</p>

    <% if registered_player? %>
      <p>
        <%= link_to "Створити колоду", new_deck_path %>
      </p>
    <% end %>

  <% end %>
</div>
