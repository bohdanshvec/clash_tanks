<div
  class="decks-page"
  data-controller="deck-preview"
>

  <header class="decks-page__header">

    <div class="decks-page__title">
      <h1>Колоды</h1>

      <% if registered_player? %>
        <p>
          Сохранённые колоды игрока:
          <strong><%= current_player.display_name %></strong>
        </p>
      <% else %>
        <p>
          Готовые стартовые колоды для ознакомления.
        </p>
      <% end %>
    </div>

    <% if registered_player? %>
      <%= link_to "Создать колоду", new_deck_path %>
    <% end %>

  </header>


  <% if registered_player? %>

    <% if @decks.any? %>

      <div class="decks-grid">

        <% @decks.each do |deck| %>

          <article class="deck-card">

            <header class="deck-card__header">

              <div>
                <h2><%= deck.name %></h2>

                <p>
                  <strong>Нация:</strong>
                  <%= deck.nation.name %>
                </p>

                <p>
                  <strong>Штаб:</strong>
                  <%= deck.headquarters_card.name %>
                </p>

                <p>
                  <strong>Карт:</strong>
                  <%= deck.card_count %> / <%= Deck::DECK_SIZE %>
                </p>

                <p>
                  <strong>Weight:</strong>
                  <%= deck.weight %>
                </p>
              </div>

            </header>

            <div class="deck-card__actions">

              <details class="deck-card__preview">
                <summary>
                  Просмотр колоды
                </summary>

                <ul class="deck-card__preview-list">

                  <% deck.deck_cards.includes(:card).each do |deck_card| %>

                    <% card = deck_card.card %>

                    <li class="deck-card__preview-item">

                      <span>
                        <%= card.name %>

                        <% if deck_card.quantity > 1 %>
                          × <%= deck_card.quantity %>
                        <% end %>
                      </span>

                      <div class="deck-card__card-preview">

                        <article class="card">

                          <header class="card__header">
                            <strong><%= card.name %></strong>
                          </header>

                          <div class="card__stats">

                            <p>
                              Nation: <%= card.nation.name %>
                            </p>

                            <p>
                              Type: <%= card.card_type %>
                            </p>

                            <p>
                              Weight: <%= card.weight %>
                            </p>

                            <p>
                              Price: <%= card.price %>
                            </p>

                            <% if card.card_type == "technique" && card.technique %>

                              <p>
                                Technique:
                                <%= card.technique.technique_type %>
                              </p>

                              <p>
                                HP: <%= card.technique.hp %>
                              </p>

                              <p>
                                Firepower: <%= card.technique.firepower %>
                              </p>

                              <p>
                                Fuel: <%= card.technique.fuel %>
                              </p>

                            <% elsif card.card_type == "platoon" && card.platoon %>

                              <p>
                                HP: <%= card.platoon.hp %>
                              </p>

                              <p>
                                Firepower: <%= card.platoon.firepower %>
                              </p>

                              <p>
                                Armor: <%= card.platoon.armor %>
                              </p>

                              <p>
                                Fuel: <%= card.platoon.fuel %>
                              </p>

                            <% elsif card.card_type == "order" %>

                              <div class="card__abilities">

                                <p>Abilities:</p>

                                <% if card.abilities.any? %>

                                  <ul>

                                    <% card.abilities.each do |ability| %>

                                      <li>
                                        <%= ability.name %>
                                      </li>

                                    <% end %>

                                  </ul>

                                <% else %>

                                  <p>none</p>

                                <% end %>

                              </div>

                            <% end %>

                          </div>

                        </article>

                      </div>

                    </li>

                  <% end %>

                </ul>

              </details>

              <%= link_to "Редактировать", edit_deck_path(deck) %>

              <%= button_to "Удалить",
                            deck_path(deck),
                            method: :delete,
                            form: {
                              data: {
                                turbo_confirm: "Удалить колоду «#{deck.name}»?"
                              }
                            } %>

            </div>

          </article>

        <% end %>

      </div>

    <% else %>

      <p>У вас пока нет сохранённых колод.</p>

    <% end %>


  <% else %>

    <div class="decks-grid">

      <% @starter_decks.each do |deck| %>

        <article class="deck-card">

					<header class="deck-card__header">

						<div>

							<h2><%= deck[:name] %></h2>

							<p>
								<strong>Нация:</strong>
								<%= deck[:nation].name %>
							</p>

							<p>
								<strong>Штаб:</strong>
								<%= deck[:headquarters_card].name %>
							</p>

							<p>
								<strong>Карт:</strong>
								<%= deck[:cards].size %> / <%= Deck::DECK_SIZE %>
							</p>

							<p>
								<strong>Weight:</strong>
								<%= deck[:cards].sum(&:weight) %>
							</p>

						</div>

					</header>


          <div class="deck-card__cards">

            <h3>Состав</h3>

            <ul>

              <% deck[:cards].each do |card| %>

                <li class="deck-card__card">

                  <span>
                    <%= card.name %>
                  </span>

                  <div class="deck-card__card-preview">

                    <article class="card">

                      <header class="card__header">
                        <strong><%= card.name %></strong>
                      </header>

                      <div class="card__stats">

                        <p>
                          Nation: <%= card.nation.name %>
                        </p>

                        <p>
                          Type: <%= card.card_type %>
                        </p>

                        <p>
                          Weight: <%= card.weight %>
                        </p>

                        <p>
                          Price: <%= card.price %>
                        </p>

                        <% if card.card_type == "technique" && card.technique %>

                          <p>
                            Technique:
                            <%= card.technique.technique_type %>
                          </p>

                          <p>
                            HP: <%= card.technique.hp %>
                          </p>

                          <p>
                            Firepower: <%= card.technique.firepower %>
                          </p>

                          <p>
                            Fuel: <%= card.technique.fuel %>
                          </p>

                        <% elsif card.card_type == "platoon" && card.platoon %>

                          <p>
                            HP: <%= card.platoon.hp %>
                          </p>

                          <p>
                            Firepower: <%= card.platoon.firepower %>
                          </p>

                          <p>
                            Armor: <%= card.platoon.armor %>
                          </p>

                          <p>
                            Fuel: <%= card.platoon.fuel %>
                          </p>

                        <% elsif card.card_type == "order" %>

                          <div class="card__abilities">

                            <p>Abilities:</p>

                            <% if card.abilities.any? %>

                              <ul>

                                <% card.abilities.each do |ability| %>

                                  <li>
                                    <%= ability.name %>
                                  </li>

                                <% end %>

                              </ul>

                            <% else %>

                              <p>none</p>

                            <% end %>

                          </div>

                        <% end %>

                      </div>

                    </article>

                  </div>

                </li>

              <% end %>

            </ul>

          </div>

        </article>

      <% end %>

    </div>

  <% end %>

</div>
