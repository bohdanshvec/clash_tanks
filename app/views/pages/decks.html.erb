
<div
  class="decks-page"
  data-controller="deck-preview"
>

  <header class="decks-page__header page-title-panel">

    <div class="decks-page__title">

      <div class="decks-page__title-row">

        <h1>Колоди</h1>

        <% if registered_player? %>
          <%= link_to "Створити колоду",
                      new_deck_path,
                      class: "decks-page__create-button" %>
        <% end %>

      </div>

      <% if registered_player? %>

        <p>
          Збережені колоди гравця:
          <strong><%= current_player.display_name %></strong>
        </p>

      <% else %>

        <p>
          Готові стартові колоди для ознайомлення.
        </p>

      <% end %>

    </div>

  </header>

  <% if registered_player? %>

    <% if @decks.any? %>

      <div class="decks-grid">

        <% @decks.each do |deck| %>

          <% card_count = deck.card_count %>

          <article class="deck-card">

            <div class="deck-card__headquarters">

              <%= render "cards/card",
                         card: deck.headquarters_card %>

            </div>

            <section class="deck-card__info">

              <h2>
                <%= deck.name %>
              </h2>

              <div class="deck-card__metrics">

                <p class="deck-card__metric">

                  <span>Карт</span>

                  <strong class="deck-card__count <%= 'deck-card__count--incomplete' if card_count != Deck::DECK_SIZE %>">
                    <%= card_count %>/<%= Deck::DECK_SIZE %>
                  </strong>

                </p>

                <p class="deck-card__metric">

                  <span>Вага</span>

                  <strong>
                    <%= deck.weight %>
                  </strong>

                </p>

              </div>

            </section>

            <div class="deck-card__actions">

              <button
                type="button"
                class="deck-card__preview-button"
                data-action="click->deck-preview#open"
              >
                Переглянути
              </button>

              <%= link_to "Редагувати",
                          edit_deck_path(deck),
                          class: "deck-card__edit-button" %>

              <%= button_to "Видалити",
                            deck_path(deck),
                            method: :delete,
                            form_class: "deck-card__delete-form",
                            class: "deck-card__delete-button",
                            data: {
                              turbo_confirm: "Видалити колоду?"
                            } %>

            </div>

            <%= render "decks/preview_dialog",
                       dialog_id: "deck-#{deck.id}",
                       title: deck.name,
                       cards: deck.deck_cards.map { |deck_card|
                         [deck_card.card, deck_card.quantity]
                       } %>

          </article>

        <% end %>

      </div>

    <% else %>

      <p>У вас поки немає збережених колод.</p>

    <% end %>

  <% else %>

    <div class="decks-grid">

      <% @starter_decks.each do |deck| %>

        <% headquarters_card = deck[:headquarters_card] %>
        <% card_count = deck[:cards].size %>

        <article class="deck-card">

          <div class="deck-card__headquarters">

            <%= render "cards/card",
                       card: headquarters_card %>

          </div>

          <section class="deck-card__info">

            <h2>
              <%= deck[:name] %>
            </h2>

            <div class="deck-card__metrics">

              <p class="deck-card__metric">

                <span>Карт</span>

                <strong class="deck-card__count <%= 'deck-card__count--incomplete' if card_count != Deck::DECK_SIZE %>">
                  <%= card_count %>/<%= Deck::DECK_SIZE %>
                </strong>

              </p>

              <p class="deck-card__metric">

                <span>Вага</span>

                <strong>
                  <%= deck[:cards].sum(&:weight) %>
                </strong>

              </p>

            </div>

          </section>

          <div class="deck-card__actions">

            <button
              type="button"
              class="deck-card__preview-button"
              data-action="click->deck-preview#open"
            >
              Переглянути
            </button>

          </div>

          <%= render "decks/preview_dialog",
                     dialog_id: "starter-#{headquarters_card.id}",
                     title: deck[:name],
                     cards: deck[:cards].map { |card| [card, 1] } %>

        </article>

      <% end %>

    </div>

  <% end %>

</div>
