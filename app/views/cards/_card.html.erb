
<%
  is_headquarters = card.card_type == "headquarters"

  platoon_variant =
    if card.card_type == "platoon"
      card.platoon&.firepower.to_i.positive? ? "attack" : "defense"
    end

  border_variant =
    case card.card_type
    when "technique"
      "ability" if card.abilities.any?
    when "platoon"
      platoon_variant
    end

  image_path = card_image_path(
    nation: card.nation.code,
    display: "card",
    type: card.card_type,
    code: card.code
  )

  border_path = card_border_path(
    nation: card.nation.code,
    display: is_headquarters ? "card" : "deck",
    type: card.card_type,
    variant: border_variant
  )

  order_descriptions = card.card_abilities.filter_map do |card_ability|
    parameters = card_ability.parameters.to_h

    case card_ability.ability.code
    when "damage_technique"
      damage = parameters["damage"]
      "Завдає техніці #{damage} од. шкоди" if damage.present?
    when "draw_cards"
      count = parameters["count"]
      "Добрати карт: #{count}" if count.present?
    end
  end
%>

<article class="catalog-card catalog-card--<%= card.card_type %>">

  <div class="catalog-card__image">

    <%= image_tag image_path,
      class: "catalog-card__illustration",
      alt: card.name %>

    <%= image_tag border_path,
      class: "catalog-card__frame",
      alt: "" %>

    <% unless is_headquarters %>

    <div class="catalog-card__weight">
      <span>Level</span>
      <span class="catalog-card__weight-value">
        <%= card.weight %>
      </span>
    </div>

    <% end %>

    <% if card.card_type == "technique" && card.technique %>

      <div class="catalog-card__type catalog-card__type--technique">
        <span class="catalog-card__technique-symbol catalog-card__technique-symbol--<%= card.technique.technique_type %>"></span>
      </div>

    <% elsif card.card_type == "platoon" && card.platoon %>

      <div class="catalog-card__type catalog-card__type--platoon">
        <% if platoon_variant == "attack" %>
          <span class="catalog-card__platoon-symbol catalog-card__platoon-symbol--attack"></span>
        <% else %>
          <span class="catalog-card__platoon-symbol catalog-card__platoon-symbol--defense"></span>
        <% end %>
      </div>

    <% elsif card.card_type == "order" %>

      <div class="catalog-card__type catalog-card__type--order">
        <span class="catalog-card__scroll-symbol"></span>
      </div>

    <% end %>

    <% unless is_headquarters %>
      <div class="catalog-card__price">
        <%= image_tag "icons/fuel_canister.png",
          class: "catalog-card__price-icon",
          alt: "" %>
        <span><%= card.price %></span>
      </div>
    <% end %>

    <div class="catalog-card__name">
      <%= card.name %>
    </div>

    <% if card.card_type == "headquarters" && card.headquarters %>

      <div class="catalog-card__stats catalog-card__stats--headquarters">

        <span class="catalog-card__stat">
          <%= card.headquarters.firepower %>
        </span>

        <span class="catalog-card__stat">
          <%= card.headquarters.hp %>
        </span>

        <span class="catalog-card__stat">
          <%= card.headquarters.fuel %>
        </span>

      </div>

    <% elsif card.card_type == "technique" && card.technique %>

      <div class="catalog-card__stats">

        <span class="catalog-card__stat">
          <%= card.technique.firepower %>
        </span>

        <span class="catalog-card__stat">
          <%= card.technique.hp %>
        </span>

        <span class="catalog-card__stat">
          <%= card.technique.fuel %>
        </span>

      </div>

    <% elsif card.card_type == "platoon" && card.platoon %>

      <div class="catalog-card__stats">

        <span class="catalog-card__stat">
          <%= platoon_variant == "attack" ? card.platoon.firepower : card.platoon.armor %>
        </span>

        <span class="catalog-card__stat">
          <%= card.platoon.hp %>
        </span>

        <span class="catalog-card__stat">
          <%= card.platoon.fuel %>
        </span>

      </div>

    <% elsif card.card_type == "order" %>

      <div class="catalog-card__description">

        <% if order_descriptions.any? %>
          <% order_descriptions.each do |description| %>
            <p><%= description %></p>
          <% end %>
        <% else %>
          <p><%= card.abilities.map(&:name).to_sentence %></p>
        <% end %>

      </div>

    <% end %>

  </div>

</article>
