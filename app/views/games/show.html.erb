<div
  data-controller="ai-turn"
  data-ai-turn-url-value="<%= run_ai_turn_path(@game) %>"
  data-ai-turn-enabled-value="<%= @game.mode == "ai" %>"
>
  <%= turbo_stream_from [@game, @current_player_id] %>

  <div id="game-content">
    <%= render "game",
               game: @game,
               visible_state: @visible_state,
               current_player_id: @current_player_id,
               events: [] %>
  </div>
</div>
