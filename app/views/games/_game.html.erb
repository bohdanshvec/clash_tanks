<%
  current_player_id = current_player_id.to_s

  current_player = visible_state["players"][current_player_id]

  opponent_player_id =
    visible_state["players"].keys
      .map(&:to_s)
      .find { |player_id| player_id != current_player_id }

  opponent_player =
    opponent_player_id ? visible_state["players"][opponent_player_id] : nil

  current_player_starts_at_bottom_left =
    visible_state["field"][2][0]&.dig("player_id")&.to_s == current_player_id

  game_finished = visible_state["status"] == "finished"

  nation_codes_by_id = Nation.pluck(:id, :code).to_h

  cards_by_id =
    Card.includes(
      :nation,
      :technique,
      :platoon,
      card_abilities: :ability
    ).index_by(&:id)

  order_preview_cards =
    events.filter_map do |event|
      event_type = event[:type] || event["type"]
      next unless event_type.to_s == "order_played"

      card_id = event[:card_id] || event["card_id"]

      cards_by_id[card_id.to_i]
    end.uniq(&:id)

  card_codes_by_id =
    cards_by_id.transform_values(&:code)

  headquarters_by_player_id =
    visible_state["field"]
      .flatten
      .compact
      .select { |cell| cell["type"] == "headquarters" }
      .index_by { |cell| cell["player_id"].to_s }

  headquarters_firepower_available_by_player_id =
    headquarters_by_player_id.transform_values do |headquarters|
      if headquarters["player_id"].to_s ==
         visible_state["current_player_id"].to_s
        !headquarters["has_attacked"]
      else
        !headquarters["has_counterattacked"]
      end
    end
%>

<div class="game <%= "game--finished" if game_finished %>"
      data-controller="game-events game-timer"
      data-game-events-events-value="<%= events.to_json %>"
      data-game-events-available-actions-value="<%= visible_state["available_actions"].to_json %>"
      data-player-id="<%= current_player_id %>"
      data-move-url="<%= move_path(game) %>"
      data-attack-url="<%= attack_path(game) %>"
      data-play-card-url="<%= play_card_path(game) %>"
      data-game-timer-game-status-value="<%= visible_state["status"] %>"
      data-game-timer-current-player-id-value="<%= visible_state["current_player_id"] %>"
      data-game-timer-turn-started-at-value="<%= visible_state["turn_started_at"] %>"
      data-game-timer-server-time-value="<%= visible_state["server_time"] %>"
      data-game-timer-turn-duration-value="<%= GameEngine::GameState::TURN_TIME %>"
      data-game-timer-end-turn-url-value="<%= end_turn_path(game) %>"
      data-game-timer-player-id-value="<%= current_player_id %>"
      data-action="
        click->game-events#handleActionClick
        mouseover->game-events#mouseOver
        mouseout->game-events#mouseOut
        dragstart->game-events#dragStart
        dragover->game-events#dragOver
        dragleave->game-events#dragLeave
        drop->game-events#drop
        dragend->game-events#dragEnd
      ">

  <% if game_finished && visible_state["result"] %>
    <%
      game_result = visible_state["result"]

      winner_id = game_result["winner_id"].to_s
      player_won = winner_id == current_player_id

      finish_reason = game_result["reason"]

      finish_reason_text =
        case finish_reason
        when "surrender"
          player_won ? "Суперник здався" : "Ви здалися"

        when "headquarters_destroyed", "empty_deck_damage"
          player_won ? "Штаб суперника знищено" : "Ваш штаб знищено"

        when "time_expired"
          player_won ? "У суперника закінчився час" : "У вас закінчився час"

        else
          "Партію завершено"
        end
    %>

    <div class="game-result">

      <h2>
        <%= player_won ? "Перемога!" : "Ви програли!" %>
      </h2>

      <%= link_to "Вийти з партії",
                  root_path,
                  class: "game-result__exit" %>

      <p class="game-result__reason">
        <%= finish_reason_text %>
      </p>

    </div>
  <% end %>

  <div class="<%= "game-content game-content--muted" if game_finished %>">

    <%# Верхняя строка: количество карт соперника и полноэкранный режим. %>
    <section class="game-top">

      <div class="game-top__hand">
        <% if opponent_player %>
          <p class="opponent-hand-count">
            У суперника <%= opponent_player["hand_count"] %> карт в руці
          </p>
        <% end %>
      </div>

      <button
        type="button"
        class="app-header__fullscreen"
        data-site-fullscreen-target="button"
        data-action="click->site-fullscreen#toggle"
        aria-pressed="false"
      >
        На весь екран
      </button>

    </section>

    <section class="game-board">

      <%# Информация текущего игрока. %>
      <aside class="game-board__player-info game-board__player-info--own">

        <div class="game-board__action game-board__action--surrender">
          <%= button_to "Здатися",
                        surrender_path(game),
                        method: :post %>
        </div>

        <% if current_player %>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Час</span>
            <strong
              data-game-timer-target="gameTime"
              data-player-id="<%= current_player_id %>"
              data-remaining-time="<%= current_player["remaining_time"] %>"
            ></strong>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Хід</span>

            <% if visible_state["current_player_id"].to_s == current_player_id %>
              <strong data-game-timer-target="turnTime"></strong>
            <% else %>
              <strong>—</strong>
            <% end %>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Колода</span>

            <strong
              class="game-board__info-value"
              data-deck-count-player-id="<%= current_player_id %>"
            >
              <%= image_tag(
                "icons/fan_of_cards.png",
                class: "game-board__info-icon",
                alt: "",
                draggable: false
              ) %>

              <span class="game-board__deck-count">
                <span><%= current_player["deck_count"] %></span>

                <% if current_player["deck_count"].zero? %>
                  <span class="game-board__deck-damage">
                    <%= current_player["empty_deck_draw_attempts"].to_i + 1 %>
                  </span>
                <% end %>
              </span>
            </strong>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Ресурси</span>

            <strong class="game-board__info-value">
              <%= image_tag(
                "icons/barrels.png",
                class: "game-board__info-icon",
                alt: "",
                draggable: false
              ) %>

              <span><%= current_player["resources"] %></span>
            </strong>

            <span class="game-board__fuel-on-field">
              <span>on field</span>
              <strong><%= current_player["fuel_on_field"] %></strong>
            </span>
          </p>

          <% if visible_state["current_player_id"].to_s == current_player_id %>
            <div class="game-board__action game-board__action--end-turn">
              <%= button_to "Кінець ходу",
                            end_turn_path(game),
                            method: :post %>
            </div>
          <% end %>

        <% end %>

      </aside>

      <%# Взводы текущего игрока. %>
      <aside class="game-board__left platoon-bar"
             data-platoon-bar
             data-player-id="<%= current_player_id %>">

        <% if current_player %>

          <% current_player["platoons"].each_with_index do |platoon, index| %>

            <article class="platoon-slot"
                     data-platoon-slot="<%= index %>"
                     data-player-id="<%= current_player_id %>"
                     <% if platoon %>
                       data-firepower="<%= platoon["firepower"].to_i %>"
                       data-armor="<%= platoon["armor"].to_i %>"
                     <% end %>>

              <% if platoon %>
                <%
                  platoon_nation =
                    nation_codes_by_id[platoon["nation_id"].to_i]

                  platoon_card_code =
                    card_codes_by_id[platoon["card_id"].to_i]

                  platoon_variant =
                    if platoon["firepower"].to_i > 0
                      "attack"
                    elsif platoon["armor"].to_i > 0
                      "defense"
                    end

                  platoon_image_available =
                    %w[usa germany ussr].include?(platoon_nation) &&
                    platoon_card_code.present? &&
                    platoon_variant.present?
                %>

                <% if platoon_image_available %>

                  <div class="platoon-field platoon-field--own"
                       title="<%= platoon["name"] %>">

                    <div class="platoon-field__illustration">
                      <%= image_tag(
                        card_image_path(
                          nation: platoon_nation,
                          display: "field",
                          type: "platoon",
                          code: platoon_card_code
                        ),
                        alt: "",
                        draggable: false
                      ) %>
                    </div>

                    <%= image_tag(
                      card_border_path(
                        nation: platoon_nation,
                        display: "field",
                        type: "platoon",
                        variant: platoon_variant
                      ),
                      class: "platoon-field__frame",
                      alt: "",
                      draggable: false
                    ) %>

                    <div class="platoon-field__name">
                      <%= platoon["name"] %>
                    </div>

                    <div class="platoon-field__type"
                         title="<%= platoon_variant == "attack" ? "Атакувальний взвод" : "Захисний взвод" %>">
                      <span class="platoon-field__type-symbol platoon-field__type-symbol--<%= platoon_variant %>"></span>
                    </div>

                    <div class="platoon-field__stats">

                      <span class="platoon-field__stat platoon-field__stat--primary <%= "platoon-field__stat--ready" if platoon_variant == "attack" && headquarters_firepower_available_by_player_id[current_player_id] %>"
                            title="<%= platoon_variant == "attack" ? "Вогнева міць" : "Броня" %>">
                        <%= platoon_variant == "attack" ? platoon["firepower"] : platoon["armor"] %>
                      </span>

                      <span class="platoon-field__stat platoon-field__stat--hp"
                            title="Міцність">
                        <%= platoon["hp"] %>
                      </span>

                      <span class="platoon-field__stat platoon-field__stat--fuel"
                            title="Пальне">
                        <%= platoon["fuel"] %>
                      </span>

                    </div>

                  </div>

                <% else %>

                  <strong><%= platoon["name"] %></strong>
                  <p>HP: <%= platoon["hp"] %></p>
                  <p>Firepower: <%= platoon["firepower"] %></p>
                  <p>Armor: <%= platoon["armor"] %></p>
                  <p>Fuel: <%= platoon["fuel"] %></p>

                <% end %>
              <% end %>

            </article>

          <% end %>

        <% end %>

      </aside>

      <%# Центральное игровое поле. %>
      <section class="game-board__field">

        <%# Скрытые копии разыгрываемых приказов для анимации обоим игрокам. %>
        <div class="game-order-card-previews" hidden>

          <% order_preview_cards.each do |order_card| %>

            <div
              data-order-preview-card-id="<%= order_card.id %>"
              data-order-ability-codes="<%= order_card.card_abilities.map { |item| item.ability.code }.join(" ") %>"
            >
              <%= render "cards/card",
                         card: order_card,
                         display: "deck" %>
            </div>

          <% end %>

        </div>

        <%# Изображение веера карт для приказа добора. %>
        <div class="game-order-assets" hidden>

          <%= image_tag(
            "icons/fan_cards_for_order.png",
            data: { game_order_fan_cards: true },
            alt: "",
            draggable: false
          ) %>

        </div>

        <div class="battlefield">

          <%
            row_indices =
              if current_player_starts_at_bottom_left
                (0...visible_state["field"].length)
              else
                (visible_state["field"].length - 1).downto(0)
              end
          %>

          <% row_indices.each do |row_index| %>

            <%
              row = visible_state["field"][row_index]

              column_indices =
                if current_player_starts_at_bottom_left
                  (0...row.length)
                else
                  (row.length - 1).downto(0)
                end
            %>

            <% column_indices.each do |column_index| %>

              <%
                cell = row[column_index]
              %>

              <div class="battlefield__cell"
                   data-position="<%= row_index %>,<%= column_index %>"
                   <% if cell && cell["type"] == "headquarters" %>
                     data-headquarters-player-id="<%= cell["player_id"] %>"
                   <% end %>
                   <% if cell &&
                         cell["player_id"].to_s == current_player_id &&
                         ["technique", "headquarters"].include?(cell["type"]) %>
                     data-action="click->game-events#select"
                     data-object-type="<%= cell["type"] %>"
                   <% end %>>

                <% if cell %>

                  <div class="cell-object <%= "cell-object--headquarters" if cell["type"] == "headquarters" %> <%= "cell-object--technique" if cell["type"] == "technique" %>">

                    <% unless %w[headquarters technique].include?(cell["type"]) %>
                      <strong>
                        <%= cell["name"] %>
                      </strong>
                    <% end %>

                    <% if cell["type"] == "technique" %>

                      <%
                        technique_nation =
                          nation_codes_by_id[cell["nation_id"].to_i]

                        technique_card_code =
                          card_codes_by_id[cell["card_id"].to_i]

                        technique_type = cell["technique_type"].to_s

                        supported_technique_types =
                          %w[
                            light_tank
                            medium_tank
                            heavy_tank
                            tank_destroyer
                            artillery
                          ]

                        technique_image_available =
                          %w[usa germany ussr].include?(technique_nation) &&
                          technique_card_code.present? &&
                          supported_technique_types.include?(technique_type)

                        technique_is_current_players_object =
                          cell["player_id"].to_s ==
                            visible_state["current_player_id"].to_s

                        technique_is_own =
                          cell["player_id"].to_s == current_player_id

                        technique_firepower_available =
                          if technique_is_current_players_object
                            !cell["has_attacked"]
                          else
                            !cell["has_counterattacked"]
                          end

                        movement_limit =
                          cell["movement_limit"].to_i

                        movement_count =
                          cell["movement_count"].to_i

                        movement_remaining =
                          movement_count.clamp(0, movement_limit)

                        technique_has_available_actions =
                          technique_firepower_available ||
                          (
                            technique_is_current_players_object &&
                            movement_remaining.positive?
                          )

                        technique_muted =
                          !technique_has_available_actions

                        technique_type_names = {
                          "light_tank" => "Легкий танк",
                          "medium_tank" => "Середній танк",
                          "heavy_tank" => "Важкий танк",
                          "tank_destroyer" => "ПТ-САУ",
                          "artillery" => "САУ"
                        }
                      %>

                      <% if technique_image_available %>

                        <div class="technique-field <%= technique_is_own ? "technique-field--own" : "technique-field--enemy" %> <%= "game-object--muted" if technique_muted %>"
                             title="<%= cell["name"] %>"
                             data-technique-nation="<%= technique_nation %>"
                             data-technique-type="<%= technique_type %>">

                          <div class="technique-field__illustration">

                            <%= image_tag(
                              card_image_path(
                                nation: technique_nation,
                                display: "field",
                                type: "technique",
                                code: technique_card_code
                              ),
                              alt: "",
                              draggable: false
                            ) %>

                          </div>

                          <%= image_tag(
                            card_border_path(
                              nation: technique_nation,
                              display: "field",
                              type: "technique"
                            ),
                            class: "technique-field__frame",
                            alt: "",
                            draggable: false
                          ) %>

                          <div class="technique-field__name">
                            <%= cell["name"] %>
                          </div>

                          <div class="technique-field__type technique-field__type--<%= technique_type %>"
                               title="<%= technique_type_names[technique_type] %>"
                               aria-label="<%= technique_type_names[technique_type] %>">

                            <span class="technique-field__type-symbol"></span>

                          </div>

                          <div class="technique-field__movement"
                               title="Залишилось переміщень: <%= movement_remaining %> із <%= movement_limit %>"
                               aria-label="Залишилось переміщень: <%= movement_remaining %> із <%= movement_limit %>">

                            <% movement_limit.times do |index| %>

                              <span class="technique-field__wheel <%= "technique-field__wheel--ready" if technique_is_current_players_object && index < movement_remaining %>"></span>

                            <% end %>

                          </div>

                          <div class="technique-field__stats">

                            <span class="technique-field__stat technique-field__stat--firepower <%= "technique-field__stat--ready" if technique_firepower_available %>"
                                  title="Вогнева міць">
                              <%= cell["firepower"] %>
                            </span>

                            <span class="technique-field__stat technique-field__stat--hp"
                                  title="Міцність">
                              <%= cell["hp"] %>
                            </span>

                            <span class="technique-field__stat technique-field__stat--fuel"
                                  title="Пальне">
                              <%= cell["fuel"] %>
                            </span>

                          </div>

                        </div>

                      <% else %>

                        <strong><%= cell["name"] %></strong>

                        <p>Тип: <%= cell["technique_type"] %></p>
                        <p>Міцність: <%= cell["hp"] %></p>
                        <p>Вогнева міць: <%= cell["firepower"] %></p>
                        <p>Пальне: <%= cell["fuel"] %></p>

                      <% end %>

                    <% elsif cell["type"] == "platoon" %>

                      <p>HP: <%= cell["hp"] %></p>
                      <p>Firepower: <%= cell["firepower"] %></p>
                      <p>Armor: <%= cell["armor"] %></p>
                      <p>Fuel: <%= cell["fuel"] %></p>

                    <% elsif cell["type"] == "headquarters" %>

                      <%
                        headquarters_player =
                          visible_state["players"][cell["player_id"].to_s]

                        headquarters_nation =
                          nation_codes_by_id[headquarters_player["nation_id"].to_i]

                        supported_headquarters_nations =
                          %w[usa ussr germany]

                        headquarters_card_code =
                          card_codes_by_id[cell["card_id"].to_i]

                        is_current_players_object =
                          cell["player_id"].to_s == visible_state["current_player_id"].to_s

                        is_own_headquarters =
                          cell["player_id"].to_s == current_player_id

                        firepower_available =
                          if is_current_players_object
                            !cell["has_attacked"]
                          else
                            !cell["has_counterattacked"]
                          end

                        headquarters_muted =
                          !firepower_available
                      %>

                      <% if supported_headquarters_nations.include?(headquarters_nation) && headquarters_card_code.present? %>

                        <div class="headquarters-field <%= is_own_headquarters ? "headquarters-field--own" : "headquarters-field--enemy" %> <%= "game-object--muted" if headquarters_muted %>"
                             title="<%= cell["name"] %>"
                             data-headquarters-nation="<%= headquarters_nation %>">

                          <div class="headquarters-field__illustration">

                            <%= image_tag(
                              card_image_path(
                                nation: headquarters_nation,
                                display: "field",
                                type: "headquarters",
                                code: headquarters_card_code
                              ),
                              alt: "",
                              draggable: false
                            ) %>

                          </div>

                          <%= image_tag(
                            card_border_path(
                              nation: headquarters_nation,
                              display: "field",
                              type: "headquarters"
                            ),
                            class: "headquarters-field__frame",
                            alt: "",
                            draggable: false
                          ) %>

                          <div class="headquarters-field__stats">

                            <span class="headquarters-field__stat headquarters-field__stat--firepower <%= "headquarters-field__stat--ready" if firepower_available %>"
                                  title="Вогнева міць">
                              <%= cell["firepower"] %>
                            </span>

                            <span class="headquarters-field__stat headquarters-field__stat--hp"
                                  title="Міцність">
                              <%= cell["hp"] %>
                            </span>

                            <span class="headquarters-field__stat headquarters-field__stat--fuel"
                                  title="Пальне">
                              <%= cell["fuel"] %>
                            </span>

                          </div>

                        </div>

                      <% else %>

                        <strong><%= cell["name"] %></strong>

                        <p>HP: <%= cell["hp"] %></p>
                        <p>Firepower: <%= cell["firepower"] %></p>
                        <p>Fuel: <%= cell["fuel"] %></p>

                        <p>
                          Attacked:
                          <%= cell["has_attacked"] ? "Yes" : "No" %>
                        </p>

                        <p>
                          Counterattacked:
                          <%= cell["has_counterattacked"] ? "Yes" : "No" %>
                        </p>

                      <% end %>

                    <% end %>

                  </div>

                <% end %>

              </div>

            <% end %>

          <% end %>

        </div>

      </section>

      <%# Взводы соперника. %>
      <aside class="game-board__right platoon-bar"
             data-platoon-bar
             data-player-id="<%= opponent_player_id %>">

        <% if opponent_player %>

          <% opponent_player["platoons"].each_with_index do |platoon, index| %>

            <article class="platoon-slot"
                     data-platoon-slot="<%= index %>"
                     data-player-id="<%= opponent_player_id %>"
                     <% if platoon %>
                       data-firepower="<%= platoon["firepower"].to_i %>"
                       data-armor="<%= platoon["armor"].to_i %>"
                     <% end %>>

              <% if platoon %>
                <%
                  platoon_nation =
                    nation_codes_by_id[platoon["nation_id"].to_i]

                  platoon_card_code =
                    card_codes_by_id[platoon["card_id"].to_i]

                  platoon_variant =
                    if platoon["firepower"].to_i > 0
                      "attack"
                    elsif platoon["armor"].to_i > 0
                      "defense"
                    end

                  platoon_image_available =
                    %w[usa germany ussr].include?(platoon_nation) &&
                    platoon_card_code.present? &&
                    platoon_variant.present?
                %>

                <% if platoon_image_available %>

                  <div class="platoon-field platoon-field--enemy"
                       title="<%= platoon["name"] %>">

                    <div class="platoon-field__illustration">
                      <%= image_tag(
                        card_image_path(
                          nation: platoon_nation,
                          display: "field",
                          type: "platoon",
                          code: platoon_card_code
                        ),
                        alt: "",
                        draggable: false
                      ) %>
                    </div>

                    <%= image_tag(
                      card_border_path(
                        nation: platoon_nation,
                        display: "field",
                        type: "platoon",
                        variant: platoon_variant
                      ),
                      class: "platoon-field__frame",
                      alt: "",
                      draggable: false
                    ) %>

                    <div class="platoon-field__name">
                      <%= platoon["name"] %>
                    </div>

                    <div class="platoon-field__type"
                         title="<%= platoon_variant == "attack" ? "Атакувальний взвод" : "Захисний взвод" %>">
                      <span class="platoon-field__type-symbol platoon-field__type-symbol--<%= platoon_variant %>"></span>
                    </div>

                    <div class="platoon-field__stats">

                      <span class="platoon-field__stat platoon-field__stat--primary <%= "platoon-field__stat--ready" if platoon_variant == "attack" && headquarters_firepower_available_by_player_id[opponent_player_id] %>"
                            title="<%= platoon_variant == "attack" ? "Вогнева міць" : "Броня" %>">
                        <%= platoon_variant == "attack" ? platoon["firepower"] : platoon["armor"] %>
                      </span>

                      <span class="platoon-field__stat platoon-field__stat--hp"
                            title="Міцність">
                        <%= platoon["hp"] %>
                      </span>

                      <span class="platoon-field__stat platoon-field__stat--fuel"
                            title="Пальне">
                        <%= platoon["fuel"] %>
                      </span>

                    </div>

                  </div>

                <% else %>

                  <strong><%= platoon["name"] %></strong>
                  <p>HP: <%= platoon["hp"] %></p>
                  <p>Firepower: <%= platoon["firepower"] %></p>
                  <p>Armor: <%= platoon["armor"] %></p>
                  <p>Fuel: <%= platoon["fuel"] %></p>

                <% end %>
              <% end %>

            </article>

          <% end %>

        <% end %>

      </aside>

      <%# Информация соперника. %>
      <aside class="game-board__player-info game-board__player-info--enemy">

        <% if opponent_player %>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Час</span>
            <strong
              data-game-timer-target="gameTime"
              data-player-id="<%= opponent_player_id %>"
              data-remaining-time="<%= opponent_player["remaining_time"] %>"
            ></strong>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Хід</span>

            <% if visible_state["current_player_id"].to_s == opponent_player_id %>
              <strong data-game-timer-target="turnTime"></strong>
            <% else %>
              <strong>—</strong>
            <% end %>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Колода</span>

            <strong
              class="game-board__info-value"
              data-deck-count-player-id="<%= opponent_player_id %>"
            >
              <%= image_tag(
                "icons/fan_of_cards.png",
                class: "game-board__info-icon",
                alt: "",
                draggable: false
              ) %>

              <span class="game-board__deck-count">
                <span><%= opponent_player["deck_count"] %></span>

                <% if opponent_player["deck_count"].zero? %>
                  <span class="game-board__deck-damage">
                    <%= opponent_player["empty_deck_draw_attempts"].to_i + 1 %>
                  </span>
                <% end %>
              </span>
            </strong>
          </p>

          <p class="game-board__info-item">
            <span class="game-board__info-label">Ресурси</span>

            <strong class="game-board__info-value">
              <%= image_tag(
                "icons/barrels.png",
                class: "game-board__info-icon",
                alt: "",
                draggable: false
              ) %>

              <span><%= opponent_player["resources"] %></span>
            </strong>

            <span class="game-board__fuel-on-field">
              <span>on field</span>
              <strong><%= opponent_player["fuel_on_field"] %></strong>
            </span>
          </p>

        <% end %>

      </aside>

    </section>

    <section class="game-bottom">

    <div class="game-bottom__hand">

      <% if current_player %>

        <div class="hand hand--bottom"
             style="--hand-count: <%= current_player["hand"].length %>;">

          <% current_player["hand"].each do |hand_card| %>

            <%
              card_actions =
                visible_state["available_actions"]
                  .dig("hand", hand_card["card_id"].to_s)

              card_muted =
                visible_state["current_player_id"].to_s != current_player_id ||
                card_actions&.dig("resources_sufficient") == false

              card_record =
                cards_by_id[hand_card["card_id"].to_i]
            %>

            <% if card_record %>

              <%= render "cards/card",
                         card: card_record,
                         display: "hand",
                         player_id: current_player_id,
                         muted: card_muted %>

            <% else %>

              <%# Резервное отображение при отсутствии записи карты в БД. %>

              <article class="game-card game-object--muted"
                       draggable="true"
                       data-action="click->game-events#select"
                       data-card-id="<%= hand_card["card_id"] %>"
                       data-player-id="<%= current_player_id %>"
                       data-card-type="<%= hand_card["card_type"] %>">

                <strong><%= hand_card["name"] %></strong>

              </article>

            <% end %>

          <% end %>

        </div>

      <% end %>

    </div>

    </section>

  </div>

</div>