<%
  current_player_id = current_player_id.to_s

  current_player = visible_state["players"][current_player_id]

  opponent_player_id =
    visible_state["players"].keys
      .map(&:to_s)
      .find { |player_id| player_id != current_player_id }

  opponent_player =
    opponent_player_id ? visible_state["players"][opponent_player_id] : nil

  current_player_starts_at_bottom_left =
    visible_state["field"][2][0]&.dig("player_id")&.to_s == current_player_id

  game_finished = visible_state["status"] == "finished"

  nation_codes_by_id = Nation.pluck(:id, :code).to_h

  card_codes_by_id =
    Card.where(card_type: %w[headquarters technique])
        .pluck(:id, :code)
        .to_h
%>

<main class="game <%= "game--finished" if game_finished %>"
      data-controller="game-events game-timer"
      data-game-events-events-value="<%= events.to_json %>"
      data-game-events-available-actions-value="<%= visible_state["available_actions"].to_json %>"
      data-player-id="<%= current_player_id %>"
      data-move-url="<%= move_path(game) %>"
      data-attack-url="<%= attack_path(game) %>"
      data-play-card-url="<%= play_card_path(game) %>"
      data-game-timer-game-status-value="<%= visible_state["status"] %>"
      data-game-timer-current-player-id-value="<%= visible_state["current_player_id"] %>"
      data-game-timer-turn-started-at-value="<%= visible_state["turn_started_at"] %>"
      data-game-timer-server-time-value="<%= visible_state["server_time"] %>"
      data-game-timer-turn-duration-value="<%= GameEngine::GameState::TURN_TIME %>"
      data-game-timer-end-turn-url-value="<%= end_turn_path(game) %>"
      data-game-timer-player-id-value="<%= current_player_id %>"
      data-action="
        click->game-events#handleActionClick
        mouseover->game-events#mouseOver
        mouseout->game-events#mouseOut
        dragstart->game-events#dragStart
        dragover->game-events#dragOver
        dragleave->game-events#dragLeave
        drop->game-events#drop
        dragend->game-events#dragEnd
      ">

  <header class="game-header">

    <h3>Clash Tanks</h3>

    <p>Status: <%= visible_state["status"] %></p>
    <p>Turn: <%= visible_state["turn_number"] %></p>
    <p>Current player: <%= visible_state["current_player_id"] %></p>

    <button
      type="button"
      class="app-header__fullscreen"
      data-site-fullscreen-target="button"
      data-action="click->site-fullscreen#toggle"
      aria-pressed="false"
    >
      На весь екран
    </button>

  </header>

  <% if game_finished && visible_state["result"] %>
    <%
      winner_id = visible_state["result"]["winner_id"].to_s
      player_won = winner_id == current_player_id
    %>

    <div class="game-result">
      <h2><%= player_won ? "Перемога!" : "Ви програли!" %></h2>

      <%= link_to "Вийти з партії",
                  root_path,
                  class: "game-result__exit" %>
    </div>
  <% end %>

  <div class="<%= "game-content game-content--muted" if game_finished %>">

    <section class="game-top">

      <div class="game-top__hand">

        <% if opponent_player %>

          <p class="opponent-hand-count">
            Opponent hand: <%= opponent_player["hand_count"] %> cards
          </p>

        <% end %>

      </div>

      <aside class="game-top__info info-window">

        <% if opponent_player %>

          <p>
            Час:
            <span
              data-game-timer-target="gameTime"
              data-player-id="<%= opponent_player_id %>"
              data-remaining-time="<%= opponent_player["remaining_time"] %>"
            ></span>
          </p>

          <% if visible_state["current_player_id"].to_s == opponent_player_id %>
            <p>
              Хід:
              <span data-game-timer-target="turnTime"></span>
            </p>
          <% end %>

          <p>
            Ресурси:
            <%= opponent_player["resources"] %>
          </p>

          <p>
            Колода:
            <%= opponent_player["deck_count"] %> cards
          </p>

          <p>
            Кладовище:
            <%= opponent_player["graveyard_count"] %> cards
          </p>

        <% end %>

      </aside>

    </section>

    <section class="game-board">

      <aside class="game-board__left platoon-bar"
             data-platoon-bar
             data-player-id="<%= current_player_id %>">

        <% if current_player %>

          <% current_player["platoons"].each_with_index do |platoon, index| %>

            <article class="platoon-slot"
                     data-platoon-slot="<%= index %>"
                     data-player-id="<%= current_player_id %>"
                     <% if platoon %>
                       data-firepower="<%= platoon["firepower"].to_i %>"
                       data-armor="<%= platoon["armor"].to_i %>"
                     <% end %>>

              <span>Slot <%= index %></span>

              <% if platoon %>

                <strong><%= platoon["name"] %></strong>

                <p>HP: <%= platoon["hp"] %></p>
                <p>Firepower: <%= platoon["firepower"] %></p>
                <p>Armor: <%= platoon["armor"] %></p>
                <p>Fuel: <%= platoon["fuel"] %></p>

              <% else %>

                <span>Empty</span>

              <% end %>

            </article>

          <% end %>

        <% end %>

      </aside>

      <section class="game-board__field">

        <div class="battlefield">

          <%
            row_indices =
              if current_player_starts_at_bottom_left
                (0...visible_state["field"].length)
              else
                (visible_state["field"].length - 1).downto(0)
              end
          %>

          <% row_indices.each do |row_index| %>

            <%
              row = visible_state["field"][row_index]

              column_indices =
                if current_player_starts_at_bottom_left
                  (0...row.length)
                else
                  (row.length - 1).downto(0)
                end
            %>

            <% column_indices.each do |column_index| %>

              <%
                cell = row[column_index]
              %>

              <div class="battlefield__cell"
                   data-position="<%= row_index %>,<%= column_index %>"
                   <% if cell && cell["type"] == "headquarters" %>
                     data-headquarters-player-id="<%= cell["player_id"] %>"
                   <% end %>
                   <% if cell &&
                         cell["player_id"].to_s == current_player_id &&
                         ["technique", "headquarters"].include?(cell["type"]) %>
                     data-action="click->game-events#select"
                     data-object-type="<%= cell["type"] %>"
                   <% end %>>

                <% if cell %>

                  <div class="cell-object <%= "cell-object--headquarters" if cell["type"] == "headquarters" %> <%= "cell-object--technique" if cell["type"] == "technique" %>">

                    <% unless %w[headquarters technique].include?(cell["type"]) %>
                      <strong>
                        <%= cell["name"] %>
                      </strong>
                    <% end %>

                    <% if cell["type"] == "technique" %>

                      <%
                        technique_nation =
                          nation_codes_by_id[cell["nation_id"].to_i]

                        technique_card_code =
                          card_codes_by_id[cell["card_id"].to_i]

                        technique_type = cell["technique_type"].to_s

                        supported_technique_types =
                          %w[
                            light_tank
                            medium_tank
                            heavy_tank
                            tank_destroyer
                            artillery
                          ]

                        technique_image_available =
                          %w[usa germany ussr].include?(technique_nation) &&
                          technique_card_code.present? &&
                          supported_technique_types.include?(technique_type)

                        technique_is_current_players_object =
                          cell["player_id"].to_s ==
                            visible_state["current_player_id"].to_s

                        technique_is_own =
                          cell["player_id"].to_s == current_player_id

                        technique_firepower_available =
                          if technique_is_current_players_object
                            !cell["has_attacked"]
                          else
                            !cell["has_counterattacked"]
                          end

                        movement_limit =
                          cell["movement_limit"].to_i

                        movement_count =
                          cell["movement_count"].to_i

                        movement_remaining =
                          movement_count.clamp(0, movement_limit)

                        technique_type_names = {
                          "light_tank" => "Легкий танк",
                          "medium_tank" => "Середній танк",
                          "heavy_tank" => "Важкий танк",
                          "tank_destroyer" => "ПТ-САУ",
                          "artillery" => "САУ"
                        }
                      %>

                      <% if technique_image_available %>

                      <div class="technique-field <%= technique_is_own ? "technique-field--own" : "technique-field--enemy" %>"
                           title="<%= cell["name"] %>"
                           data-technique-nation="<%= technique_nation %>"
                           data-technique-type="<%= technique_type %>">

                          <div class="technique-field__illustration">

                            <%= image_tag(
                              card_image_path(
                                nation: technique_nation,
                                display: "field",
                                type: "technique",
                                code: technique_card_code
                              ),
                              alt: "",
                              draggable: false
                            ) %>

                          </div>

                          <%= image_tag(
                            card_border_path(
                              nation: technique_nation,
                              display: "field",
                              type: "technique"
                            ),
                            class: "technique-field__frame",
                            alt: "",
                            draggable: false
                          ) %>

                          <div class="technique-field__name">
                            <%= cell["name"] %>
                          </div>

                          <div class="technique-field__type technique-field__type--<%= technique_type %>"
                               title="<%= technique_type_names[technique_type] %>"
                               aria-label="<%= technique_type_names[technique_type] %>">

                            <span class="technique-field__type-symbol"></span>

                          </div>

                          <div class="technique-field__movement"
                               title="Залишилось переміщень: <%= movement_remaining %> із <%= movement_limit %>"
                               aria-label="Залишилось переміщень: <%= movement_remaining %> із <%= movement_limit %>">

                            <% movement_limit.times do |index| %>

                              <span class="technique-field__wheel <%= "technique-field__wheel--ready" if technique_is_current_players_object && index < movement_remaining %>"></span>

                            <% end %>

                          </div>

                          <div class="technique-field__stats">

                            <span class="technique-field__stat technique-field__stat--firepower <%= "technique-field__stat--ready" if technique_firepower_available %>"
                                  title="Вогнева міць">
                              <%= cell["firepower"] %>
                            </span>

                            <span class="technique-field__stat technique-field__stat--hp"
                                  title="Міцність">
                              <%= cell["hp"] %>
                            </span>

                            <span class="technique-field__stat technique-field__stat--fuel"
                                  title="Пальне">
                              <%= cell["fuel"] %>
                            </span>

                          </div>

                        </div>

                      <% else %>

                        <strong><%= cell["name"] %></strong>

                        <p>Тип: <%= cell["technique_type"] %></p>
                        <p>Міцність: <%= cell["hp"] %></p>
                        <p>Вогнева міць: <%= cell["firepower"] %></p>
                        <p>Пальне: <%= cell["fuel"] %></p>

                      <% end %>

                    <% elsif cell["type"] == "platoon" %>

                      <p>HP: <%= cell["hp"] %></p>
                      <p>Firepower: <%= cell["firepower"] %></p>
                      <p>Armor: <%= cell["armor"] %></p>
                      <p>Fuel: <%= cell["fuel"] %></p>

                    <% elsif cell["type"] == "headquarters" %>

                      <%
                        headquarters_player =
                          visible_state["players"][cell["player_id"].to_s]

                        headquarters_nation =
                          nation_codes_by_id[headquarters_player["nation_id"].to_i]

                        supported_headquarters_nations =
                          %w[usa ussr germany]

                        headquarters_card_code =
                          card_codes_by_id[cell["card_id"].to_i]

                        is_current_players_object =
                          cell["player_id"].to_s == visible_state["current_player_id"].to_s

                        is_own_headquarters =
                          cell["player_id"].to_s == current_player_id

                        firepower_available =
                          if is_current_players_object
                            !cell["has_attacked"]
                          else
                            !cell["has_counterattacked"]
                          end
                      %>

                      <% if supported_headquarters_nations.include?(headquarters_nation) && headquarters_card_code.present? %>

                        <div class="headquarters-field <%= is_own_headquarters ? "headquarters-field--own" : "headquarters-field--enemy" %>"
                             title="<%= cell["name"] %>"
                             data-headquarters-nation="<%= headquarters_nation %>">

                          <div class="headquarters-field__illustration">

                            <%= image_tag(
                              card_image_path(
                                nation: headquarters_nation,
                                display: "field",
                                type: "headquarters",
                                code: headquarters_card_code
                              ),
                              alt: "",
                              draggable: false
                            ) %>

                          </div>

                          <%= image_tag(
                            card_border_path(
                              nation: headquarters_nation,
                              display: "field",
                              type: "headquarters"
                            ),
                            class: "headquarters-field__frame",
                            alt: "",
                            draggable: false
                          ) %>

                          <div class="headquarters-field__stats">

                            <span class="headquarters-field__stat headquarters-field__stat--firepower <%= "headquarters-field__stat--ready" if firepower_available %>"
                                  title="Вогнева міць">
                              <%= cell["firepower"] %>
                            </span>

                            <span class="headquarters-field__stat headquarters-field__stat--hp"
                                  title="Міцність">
                              <%= cell["hp"] %>
                            </span>

                            <span class="headquarters-field__stat headquarters-field__stat--fuel"
                                  title="Пальне">
                              <%= cell["fuel"] %>
                            </span>

                          </div>

                        </div>

                      <% else %>

                        <strong><%= cell["name"] %></strong>

                        <p>HP: <%= cell["hp"] %></p>
                        <p>Firepower: <%= cell["firepower"] %></p>
                        <p>Fuel: <%= cell["fuel"] %></p>

                        <p>
                          Attacked:
                          <%= cell["has_attacked"] ? "Yes" : "No" %>
                        </p>

                        <p>
                          Counterattacked:
                          <%= cell["has_counterattacked"] ? "Yes" : "No" %>
                        </p>

                      <% end %>

                    <% end %>

                  </div>

                <% end %>

              </div>

            <% end %>

          <% end %>

        </div>

      </section>

      <aside class="game-board__right platoon-bar"
             data-platoon-bar
             data-player-id="<%= opponent_player_id %>">

        <% if opponent_player %>

          <% opponent_player["platoons"].each_with_index do |platoon, index| %>

            <article class="platoon-slot"
                     data-platoon-slot="<%= index %>"
                     data-player-id="<%= opponent_player_id %>"
                     <% if platoon %>
                       data-firepower="<%= platoon["firepower"].to_i %>"
                       data-armor="<%= platoon["armor"].to_i %>"
                     <% end %>>

              <span>Slot <%= index %></span>

              <% if platoon %>

                <strong><%= platoon["name"] %></strong>

                <p>HP: <%= platoon["hp"] %></p>
                <p>Firepower: <%= platoon["firepower"] %></p>
                <p>Armor: <%= platoon["armor"] %></p>
                <p>Fuel: <%= platoon["fuel"] %></p>

              <% else %>

                <span>Empty</span>

              <% end %>

            </article>

          <% end %>

        <% end %>

      </aside>

    </section>

    <section class="game-bottom">

      <aside class="game-bottom__info info-window">

        <% if current_player %>

          <%= button_to "Здатися",
                        surrender_path(game),
                        method: :post %>

          <p>
            Час:
            <span
              data-game-timer-target="gameTime"
              data-player-id="<%= current_player_id %>"
              data-remaining-time="<%= current_player["remaining_time"] %>"
            ></span>
          </p>

          <% if visible_state["current_player_id"].to_s == current_player_id %>

            <p>
              Хід:
              <span data-game-timer-target="turnTime"></span>
            </p>

          <% end %>

          <p>
            Ресурси:
            <%= current_player["resources"] %>
          </p>

          <p>
            Колода:
            <%= current_player["deck_count"] %> cards
          </p>

          <p>
            Кладовище:
            <%= current_player["graveyard_count"] %> cards
          </p>

          <% if visible_state["current_player_id"].to_s == current_player_id %>

            <%= button_to "Кінець ходу",
                          end_turn_path(game),
                          method: :post %>

          <% end %>

        <% end %>

      </aside>

      <div class="game-bottom__hand">

        <% if current_player %>

          <div class="hand hand--bottom"
               style="--hand-count: <%= current_player["hand"].length %>;">

            <% current_player["hand"].each do |card| %>

              <%
                card_actions =
                  visible_state["available_actions"]
                    .dig("hand", card["card_id"].to_s)

                card_muted =
                  visible_state["current_player_id"].to_s != current_player_id ||
                  card_actions&.dig("resources_sufficient") == false
              %>

              <article class="game-card <%= "game-object--muted" if card_muted %>"
                       draggable="true"
                       data-action="click->game-events#select"
                       data-card-id="<%= card["card_id"] %>"
                       data-player-id="<%= current_player_id %>"
                       data-card-type="<%= card["card_type"] %>">

                <header class="game-card__header">
                  <strong><%= card["name"] %></strong>
                </header>

                <div class="game-card__stats">

                  <% if card["card_type"] == "technique" %>

                    <p>Type: <%= card["card_type"] %></p>

                    <p>
                      Technique type:
                      <%= card.dig("technique", "technique_type") %>
                    </p>

                    <p>Price: <%= card["price"] %></p>
                    <p>HP: <%= card.dig("technique", "hp") %></p>

                    <p>
                      Firepower:
                      <%= card.dig("technique", "firepower") %>
                    </p>

                    <p>Fuel: <%= card.dig("technique", "fuel") %></p>

                  <% elsif card["card_type"] == "order" %>

                    <p>Type: <%= card["card_type"] %></p>
                    <p>Price: <%= card["price"] %></p>

                    <% abilities = card["abilities"] || [] %>

                    <div class="game-card__abilities">

                      <p>Abilities:</p>

                      <% if abilities.any? %>

                        <ul>

                          <% abilities.each do |ability| %>

                            <li>
                              <%= ability["code"] %>

                              <% if ability["code"] == "damage_technique" %>
                                — Damage: <%= ability["damage"] %>
                              <% elsif ability["code"] == "draw_cards" %>
                                — Cards: <%= ability["count"] %>
                              <% end %>
                            </li>

                          <% end %>

                        </ul>

                      <% else %>

                        <p>none</p>

                      <% end %>

                    </div>

                  <% elsif card["card_type"] == "platoon" %>

                    <p>Type: <%= card["card_type"] %></p>
                    <p>Price: <%= card["price"] %></p>
                    <p>HP: <%= card.dig("platoon", "hp") %></p>

                    <p>
                      Firepower:
                      <%= card.dig("platoon", "firepower") %>
                    </p>

                    <p>Armor: <%= card.dig("platoon", "armor") %></p>
                    <p>Fuel: <%= card.dig("platoon", "fuel") %></p>

                  <% end %>

                </div>

              </article>

            <% end %>

          </div>

        <% end %>

      </div>

    </section>

  </div>

</main>