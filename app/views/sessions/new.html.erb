<main class="auth-page">
  <section class="auth-panel" aria-labelledby="auth-title">
    <header class="auth-panel__header">
      <h1 id="auth-title">Вхід</h1>
      <p>Увійдіть до свого облікового запису Clash Tanks.</p>
    </header>

    <% if flash[:alert].present? %>
      <div class="auth-alert auth-alert--error" role="alert">
        <strong>Помилка входу</strong>
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with url: login_path, class: "auth-form" do |form| %>
      <div class="auth-form__group">
        <%= form.label :email,
              "Електронна пошта",
              class: "auth-form__label" %>

        <%= form.email_field :email,
              value: params[:email],
              class: "form-control auth-form__input",
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "example@email.com" %>
      </div>

      <div class="auth-form__group">
        <%= form.label :password,
              "Пароль",
              class: "auth-form__label" %>

        <%= form.password_field :password,
              class: "form-control auth-form__input",
              required: true,
              autocomplete: "current-password",
              placeholder: "Введіть пароль" %>
      </div>

      <%= form.submit "Увійти",
            class: "btn btn-primary auth-form__submit" %>
    <% end %>

    <footer class="auth-panel__footer">
      <p>Ще не маєте облікового запису?</p>
      <%= link_to "Зареєструватися",
            register_path,
            class: "auth-panel__link" %>
    </footer>
  </section>
</main>