<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Clash Tanks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Clash Tanks">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "vendor/bootstrap.min",
                            "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "site-background",
                        "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "theme",
                            "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag :app,
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="site-fullscreen">
    <header class="app-header" role="banner">
      <div class="app-header__inner">

        <div class="app-header__brand">
        <%= link_to "CLASH TANKS", root_path, class: "app-header__logo" %>

        <%= link_to "Головна", root_path,
                    class: "app-header__nav-link app-header__nav-link--home #{'app-header__nav-link--active' if current_page?(root_path)}",
                    aria: (current_page?(root_path) ? { current: "page" } : {}) %>
      </div>

      <nav class="app-header__nav" aria-label="Основна навігація">

        <%= link_to "Правила", rules_path,
                    class: "app-header__nav-link #{'app-header__nav-link--active' if current_page?(rules_path)}",
                    aria: (current_page?(rules_path) ? { current: "page" } : {}) %>

        <%= link_to "Карти", cards_path,
                    class: "app-header__nav-link #{'app-header__nav-link--active' if request.path.start_with?('/cards')}",
                    aria: (request.path.start_with?('/cards') ? { current: "page" } : {}) %>

        <%= link_to "Грати", play_path,
                    class: "app-header__nav-link app-header__nav-link--play #{'app-header__nav-link--active' if current_page?(play_path)}",
                    aria: (current_page?(play_path) ? { current: "page" } : {}) %>

        <%= link_to "Колоди", decks_path,
                    class: "app-header__nav-link #{'app-header__nav-link--active' if request.path.start_with?('/decks')}",
                    aria: (request.path.start_with?('/decks') ? { current: "page" } : {}) %>
            
        <%= link_to "Статистика", statistics_path,
                    class: "app-header__nav-link #{'app-header__nav-link--active' if current_page?(statistics_path)}",
                    aria: (current_page?(statistics_path) ? { current: "page" } : {}) %>

      </nav>

        <div class="app-header__player">

          <button
            type="button"
            class="app-header__fullscreen"
            data-site-fullscreen-target="button"
            data-action="click->site-fullscreen#toggle"
            aria-pressed="false"
          >
            На весь екран
          </button>

          <% if registered_player? %>
            <span class="app-header__username">
              <%= current_player.display_name %>
            </span>

            <%= button_to "Вийти", logout_path,
                          method: :delete,
                          class: "app-header__logout" %>
          <% else %>
            <span class="app-header__guest">Гість</span>

            <%= link_to "Увійти", login_path,
                        class: "app-header__auth-link" %>

            <%= link_to "Реєстрація", register_path,
                        class: "app-header__auth-link" %>
          <% end %>
        </div>

      </div>
    </header>

    <main class="site-main <%= 'site-main--rules' if controller_name == 'pages' && action_name == 'rules' %>">
      <% if flash[:notice].present? %>
        <div class="site-notice" role="status">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
